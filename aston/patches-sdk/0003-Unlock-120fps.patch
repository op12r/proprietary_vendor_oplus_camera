From ee8fa05fb94b8211d72b9e851945a408acfd8ef1 Mon Sep 17 00:00:00 2001
From: osm1019 <osm1019@gmail.com>
Date: Tue, 28 Jul 2026 12:59:24 +0800
Subject: [PATCH] Unlock 120fps

---
 .../decision/OperationModeDecision.smali      | 22 +++++++++++++++++--
 1 file changed, 20 insertions(+), 2 deletions(-)

diff --git a/smali/com/oplus/ocs/camera/producer/decision/OperationModeDecision.smali b/smali/com/oplus/ocs/camera/producer/decision/OperationModeDecision.smali
index c847071..9f9489e 100644
--- a/smali/com/oplus/ocs/camera/producer/decision/OperationModeDecision.smali
+++ b/smali/com/oplus/ocs/camera/producer/decision/OperationModeDecision.smali
@@ -243,7 +243,7 @@
 
     move-result v4
 
-    if-eqz v4, :cond_b
+    if-eqz v4, :cond_c
 
     invoke-interface {v1}, Ljava/util/Iterator;->next()Ljava/lang/Object;
 
@@ -433,6 +433,24 @@
 
     .line 113
     :cond_a
+    # The 12R camera HAL exposes 1080p and 4K constrained high speed at
+    # 120fps, but the feature table rejects video_120fps. Keep checking the
+    # remaining keys instead of failing the whole config for it.
+    const-string v4, "video_120fps"
+
+    invoke-static {v7}, Ljava/lang/String;->valueOf(Ljava/lang/Object;)Ljava/lang/String;
+
+    move-result-object v8
+
+    invoke-virtual {v4, v8}, Ljava/lang/String;->equals(Ljava/lang/Object;)Z
+
+    move-result v4
+
+    if-eqz v4, :cond_b
+
+    goto/16 :goto_0
+
+    :cond_b
     new-instance p0, Ljava/lang/StringBuilder;
 
     const-string p1, "isFeatureConfigLegal, featureName: "
@@ -473,7 +491,7 @@
 
     return p0
 
-    :cond_b
+    :cond_c
     return v2
 .end method
 
